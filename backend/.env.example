# Flask Web Server
PORT=5000
FLASK_ENV=development
DB_TYPE=sqlite

# MySQL Database Connection Details
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password_here
DB_NAME=gims_db

# Security & Authentication Configuration
# Provide a long, random, secret key to secure your stateless signatures
JWT_SECRET=replace_this_with_a_long_random_string_before_running
# Expiration time for authentication tokens in seconds (e.g. 86400 is 24 hours)
JWT_EXPIRES_IN=86400

CORS_ORIGIN=gims-7s7p-b8azwgxj4-waygo2.vercel.app
